{
  "name": "dsh-agent-guardrails",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keeps DeepSeek Harness agents from repeating mistakes: learned rules in the system prompt, a gate that refuses shell commands that fail every time in this environment, and a tool that records new rules after an avoidable error.",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
